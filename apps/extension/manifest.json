{
  "manifest_version": 3,
  "name": "VPS Panel: прокси для браузера",
  "short_name": "VPS Panel",
  "version": "1.5.0",
  "key": "",
  "description": "Выход в интернет через серверы VPS Panel только из этого браузера: HTTPS-прокси по ссылке с личной страницы.",
  "minimum_chrome_version": "120",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "alarms",
    "privacy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VPS Panel: прокси"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
