    "fastify": "^5.2.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "undici": "^8.11.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.6",
