#!/usr/bin/env python3
"""Только граница systemd: SSH, файловая система и смена пароля настоящие."""
import os
from pathlib import Path
import signal
import sys

args = sys.argv[1:]
if args[:1] == ['is-active']:
    sys.exit(0 if args[-1] == 'ssh.service' else 3)
if args == ['reload', 'ssh.service']:
    os.kill(int(Path('/run/sshd.pid').read_text()), signal.SIGHUP)
elif args[:1] not in (['stop'], ['disable'], ['daemon-reload'], ['list-units']):
    sys.exit(1)
if args[:1] == ['stop'] and args[-1] in ('ssh', 'sshd', 'ssh.service', 'sshd.service'):
    sys.exit(1)
