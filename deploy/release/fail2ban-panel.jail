# jail для панели: /etc/fail2ban/jail.d/vps-panel.conf (путь к логу подставляет vps-panel
# install: лог Caddy лежит в его docker-томе).
[vps-panel]
enabled = true
filter = vps-panel
logpath = __CADDY_LOG__
maxretry = 5
findtime = 15m
bantime = 1h
backend = polling
# Caddy в docker: опубликованные порты идут через FORWARD (цепочка DOCKER-USER), бан в INPUT
# их не закрывает.
banaction = iptables-allports
chain = DOCKER-USER
# IP своих серверов не баним: бан на всех портах отключил бы и агента этого сервера (вход в
# панель через VPN на нём же). Список ведёт панель (lib/fail2ban-ignore.ts), код 0 - пропустить.
ignorecommand = grep -qxF '<ip>' __DATA__/fail2ban-ignore.txt
