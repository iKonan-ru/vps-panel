#!/bin/bash
# vps-panel - установка, обновление и обслуживание VPS Panel из релизов GitHub.
#
#   vps-panel install [-y] [--beta] [--version X.Y.Z] [--no-agent]
#                                                        установка (вопросы: домен - можно без
#                                                        него, по IP; подписки, почта, логин);
#                                                        сервер панели сразу в списке серверов
#                                                        (--no-agent - без него)
#   vps-panel admin [show | password | 2fa | login <имя> | init [имя]] [-y]
#                                                        администратор: сброс пароля и 2FA
#   vps-panel bot off                                    отключить управление через Telegram-бота
#                                                        и отвязать аккаунт (потерян телефон)
#   vps-panel domain <имя> [--sub <имя>]                 домен панели (была по IP или другой)
#   vps-panel restore <файл .enc> [-y]                   восстановить панель из резервной копии
#                                                        (пароль - вопросом или BACKUP_PASSWORD)
#   vps-panel update [X.Y.Z] [--beta] [--force]          обновление до версии или до последней
#   vps-panel rollback                                   вернуть прошлую версию
#   vps-panel status | version | logs [panel|caddy] | restart
#   vps-panel fail2ban                                   jail fail2ban входа в панель заново
#                                                        (обновление делает это само)
#   vps-panel sites [reload]                             свои сайты (sites/*.caddy): список и
#                                                        проверка конфига Caddy; reload - применить
#                                                        без перезапуска (неверный не применяется)
#   vps-panel channel [stable|beta]                      канал для "update" без версии: стабильный
#                                                        или предварительный (beta)
#   vps-panel uninstall [--purge | --full] [-y]          снять панель (данные - с --purge);
#                                                        --full - всё, что ставила панель,
#                                                        включая агент и VPN-сервисы
#   vps-panel serve-request                              запрос обновления из панели (служба)
#
# Каталог - /opt/vps-panel (VPS_PANEL_ROOT): compose.yml (и свой compose.override.yml),
# Caddyfile, .env, data, sites (свои сайты). Образы - ghcr.io/ikonan-ru/vps-panel и
# vps-panel-caddy, файлы релиза - с GitHub. Ход обновления пишется в data/deploy.json: его
# показывает панель полосой сверху.
set -euo pipefail

REPO="iKonan-ru/vps-panel"
ROOT="${VPS_PANEL_ROOT:-/opt/vps-panel}"
ENV_FILE="$ROOT/.env"
DATA="$ROOT/data"
STATUS="$DATA/deploy.json"
REQUEST="$DATA/update/request.json"
CLI_PATH=/usr/local/bin/vps-panel
SEMVER='^[0-9]+\.[0-9]+\.[0-9]+(-beta\.[0-9]+)?$'
YES=0
# временные файлы команды: убираются при выходе (переменные глобальные - trap видит их и после
# выхода из функции)
TMPD=""
TAIL_FILE=""
# Логин и пароль, созданные установкой: если она оборвётся после этого (ошибка на позднем шаге),
# сводка всё равно печатается при выходе - иначе пароль был бы потерян.
ACCESS_LOGIN=""
ACCESS_PASSWORD=""
# Ход обновления: последний записанный итог и шаг. Обновление оборвалось (ошибка без своей
# обработки, сигнал) - при выходе в data/deploy.json пишется "не удалось", иначе панель так и
# показывала бы "выполняется". До перезапуска контейнеров на место возвращаются и прежние файлы.
UPDATING=0
SWAPPED=0
LAST_STATE=""
STEP=0
STEP_NAME=""
PREV="$ROOT/.prev"
SITES="$ROOT/sites"
on_exit() {
  local code=$?
  if [ "$UPDATING" = 1 ] && [ "$LAST_STATE" = building ]; then
    UPDATING=0
    if [ "$SWAPPED" = 1 ] && [ "$STEP" -lt 3 ]; then restore_files || true; fi
    if [ -n "${TAIL_FILE:-}" ]; then echo "обновление прервано, код выхода $code" >>"$TAIL_FILE" || true; fi
    status failed "$STEP" 4 "$STEP_NAME" || true
  fi
  rm -rf "${TMPD:-}" "${TAIL_FILE:-}"
  if [ -n "$ACCESS_LOGIN" ]; then
    print_access "$ACCESS_LOGIN" "$ACCESS_PASSWORD" "VPS Panel: установка оборвалась, но администратор создан"
  fi
}
trap on_exit EXIT
# остановка службы, обрыв ssh, Ctrl+C - через выход, чтобы on_exit записал итог
trap 'exit 143' TERM
trap 'exit 129' HUP
trap 'exit 130' INT

say() { printf '\n== %s\n' "$*"; }
warn() { printf '!! %s\n' "$*" >&2; }
die() {
  printf 'ОШИБКА: %s\n' "$*" >&2
  exit 1
}
need_root() { [ "$(id -u)" = 0 ] || die "запускать от root (sudo vps-panel ...)"; }
channel_name() { case "$1" in beta) echo "предварительный (beta)" ;; stable) echo "стабильный (stable)" ;; *) echo "$1" ;; esac; }
ask() { # ask <вопрос> <по умолчанию> - ответ в $REPLY
  if [ "$YES" = 1 ]; then REPLY="$2"; return; fi
  read -r -p "$1${2:+ [$2]}: " REPLY </dev/tty 2>/dev/null ||
    die "нет терминала для вопросов: задайте PANEL_DOMAIN (пусто - по IP), ACME_EMAIL, SUB_DOMAIN, PANEL_LOGIN и запустите с -y"
  [ -n "$REPLY" ] || REPLY="$2"
}
confirm() {
  [ "$YES" = 1 ] && return 0
  local a
  read -r -p "$1 [y/N]: " a </dev/tty 2>/dev/null || die "нет терминала для вопроса: запустите с -y"
  case "$a" in [yYдД]*) return 0 ;; *) return 1 ;; esac
}
env_get() { [ -f "$ENV_FILE" ] && sed -n "s/^$1=//p" "$ENV_FILE" | tail -1 || true; }
env_set() { # env_set <ключ> <значение>
  if grep -q "^$1=" "$ENV_FILE"; then
    python3 - "$ENV_FILE" "$1" "$2" <<'PY'
import sys
p, k, v = sys.argv[1:4]
lines = open(p, encoding="utf-8").read().splitlines(True)
open(p, "w", encoding="utf-8").write("".join(f"{k}={v}\n" if l.split("=", 1)[0] == k else l for l in lines))
PY
  else
    printf '%s=%s\n' "$1" "$2" >>"$ENV_FILE"
  fi
}
resolve4() { { getent ahostsv4 "$1" 2>/dev/null || true; } | awk '{print $1}' | sort -u | tr '\n' ' '; }
# Значения - только из .env: docker compose ставит переменные окружения выше .env, и пустой
# PANEL_DOMAIN из "PANEL_DOMAIN= vps-panel install -y" (панель по IP) оставил бы контейнеры без
# адреса.
COMPOSE_VARS=(PANEL_VERSION PANEL_DOMAIN SUB_DOMAIN ACME_EMAIL SESSION_SECRET LOG_LEVEL TG_PROXY_URL
  PANEL_TLS PANEL_SNI PANEL_ALIAS PANEL_CHANNEL CADDY_DATA_VOLUME CADDY_CONFIG_VOLUME)
# Свои правки установки - compose.override.yml рядом: с явным -f docker compose сам его не
# читает, поэтому он подключается здесь, во все команды (и в проверку при обновлении).
compose() {
  local u=() v f=(-f "$ROOT/compose.yml")
  for v in "${COMPOSE_VARS[@]}"; do u+=(-u "$v"); done
  [ -f "$ROOT/compose.override.yml" ] && f+=(-f "$ROOT/compose.override.yml")
  env "${u[@]}" docker compose --project-directory "$ROOT" "${f[@]}" --env-file "$ENV_FILE" "$@"
}
# шапка этого файла - справка (до первой строки не комментария)
print_help() { awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"; }

# Последняя версия канала: stable - только релизы, beta - и пре-релизы. Наибольшая по semver.
latest_version() { # latest_version <stable|beta>
  curl -fsSL -m 30 -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$REPO/releases?per_page=100" |
    python3 -c '
import json, re, sys
beta = sys.argv[1] == "beta"
def key(v):
    m = re.match(r"^(\d+)\.(\d+)\.(\d+)(?:-beta\.(\d+))?$", v)
    return (int(m[1]), int(m[2]), int(m[3]), 1 if m[4] is None else 0, int(m[4] or 0))
best = None
for r in json.load(sys.stdin):
    v = r.get("tag_name", "").lstrip("v")
    if r.get("draft") or not re.match(r"^\d+\.\d+\.\d+(-beta\.\d+)?$", v):
        continue
    if (r.get("prerelease") or "-" in v) and not beta:
        continue
    if best is None or key(v) > key(best):
        best = v
if not best:
    sys.exit(1)
print(best)' "$1" || die "не удалось узнать последнюю версию на GitHub (api.github.com)"
}

# Файлы релиза версии в каталог: compose.yml, Caddyfile, fail2ban, сам vps-panel; сверка с
# release.sha256 того же релиза.
fetch_release() { # fetch_release <версия> <каталог>
  local v="$1" dir="$2" f
  local base="https://github.com/$REPO/releases/download/v$v"
  for f in release.sha256 vps-panel compose.yml Caddyfile fail2ban-panel.conf fail2ban-panel.jail; do
    curl -fsSL -m 60 --retry 3 "$base/$f" -o "$dir/$f" || die "не скачался $f релиза v$v"
  done
  (cd "$dir" && sha256sum -c --quiet release.sha256) || die "файлы релиза v$v не сходятся с release.sha256"
}

# Ход обновления для панели (data/deploy.json: этап, шаг, итог)
STARTED=0
status() { # status <state> <шаг> <всего> <название> [running]
  LAST_STATE="$1" STEP="$2" STEP_NAME="$4"
  [ -d "$DATA" ] || return 0
  python3 - "$STATUS" "$1" "$2" "$3" "$4" "${TARGET:-?}" "${5:-${CURRENT:-}}" "$STARTED" "${TAIL_FILE:-}" <<'PY'
import json, os, sys, time
p, state, step, total, name, target, running, started, tail = sys.argv[1:10]
d = {"state": state, "commit": target, "startedAt": int(started), "updatedAt": int(time.time()),
     "step": int(step), "total": int(total), "stepName": name, "running": running or None}
if tail and os.path.exists(tail):
    d["tail"] = [l for l in open(tail, encoding="utf-8", errors="replace").read().splitlines() if l.strip()][-25:]
tmp = p + ".tmp"
with open(tmp, "w") as f:
    json.dump(d, f, ensure_ascii=False)
os.chmod(tmp, 0o644)
os.replace(tmp, p)
PY
}

wait_health() { # wait_health <версия> <секунд>: /api/health отвечает этой версией (-k: сертификат
  # на свежей установке может быть ещё не выпущен, а проверяется здесь только ответ панели)
  local v="$1" n=$(($2 / 5)) dom
  dom="$(env_get PANEL_DOMAIN)"
  for _ in $(seq 1 "$n"); do
    # --connect-to: и для имени, и для IP (за NAT свой внешний адрес изнутри недоступен)
    if curl -kfsS -m 8 --connect-to "$dom:443:127.0.0.1:443" "https://$dom/api/health" 2>/dev/null | grep -q "\"version\":\"$v\""; then
      return 0
    fi
    sleep 5
  done
  return 1
}

# Команда vps-panel из релиза - рядом и переименованием: запущенный скрипт bash дочитывает с
# диска по ходу работы, запись поверх него подменила бы ему продолжение.
install_cli() {
  install -m 755 "$1" "$CLI_PATH.new"
  mv -f "$CLI_PATH.new" "$CLI_PATH"
}

# прежние compose.yml, Caddyfile и .env (копия перед обновлением) - на место
restore_files() {
  cp -p "$PREV/compose.yml" "$PREV/Caddyfile" "$ROOT/"
  cp -p "$PREV/.env" "$ENV_FILE"
}

install_units() {
  cat >/etc/systemd/system/vps-panel-update.service <<UNIT
[Unit]
Description=VPS Panel: обновление по запросу из панели
After=docker.service

[Service]
Type=oneshot
ExecStart=$CLI_PATH serve-request
UNIT
  cat >/etc/systemd/system/vps-panel-update.path <<UNIT
[Unit]
Description=VPS Panel: запрос обновления из панели

[Path]
PathExists=$REQUEST
Unit=vps-panel-update.service

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload
  systemctl enable --now vps-panel-update.path >/dev/null 2>&1
}

install_fail2ban() {
  local vol log
  vol="$(env_get CADDY_DATA_VOLUME)"
  vol="${vol:-vps-panel_caddy_data}"
  log="$(docker volume inspect -f '{{.Mountpoint}}' "$vol" 2>/dev/null || true)/access.log"
  dpkg -s fail2ban >/dev/null 2>&1 || {
    command -v apt-get >/dev/null || { warn "fail2ban не установлен - защита входа в панель от перебора выключена"; return 0; }
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq fail2ban iptables >/dev/null ||
      { warn "fail2ban не поставился - защита входа в панель от перебора выключена"; return 0; }
  }
  cp "$ROOT/fail2ban-panel.conf" /etc/fail2ban/filter.d/vps-panel.conf
  sed -e "s|__CADDY_LOG__|$log|" -e "s|__DATA__|$DATA|" "$ROOT/fail2ban-panel.jail" >/etc/fail2ban/jail.d/vps-panel.conf
  if [ -f "$log" ]; then
    systemctl restart fail2ban && echo "fail2ban: jail vps-panel включён" || warn "fail2ban не перезапустился: journalctl -u fail2ban"
  else
    warn "лога Caddy ($log) ещё нет: после первого входа в панель - systemctl restart fail2ban"
  fi
}

# ---------------------------------------------------------------- install
LOGIN_RE='^[A-Za-z0-9._-]{3,32}$'
DOMAIN_RE='^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z0-9-]{2,}$'

public_ip() { # внешний IPv4 сервера
  curl -4 -fsS -m 10 https://api.ipify.org 2>/dev/null || curl -4 -fsS -m 10 https://ifconfig.me 2>/dev/null || true
}

# Администратор в контейнере панели: ответ - JSON. Панель запущена -
# exec, нет - разовый контейнер (база та же, ./data).
panel_cli() {
  if [ -n "$(compose ps -q --status running panel 2>/dev/null)" ]; then
    compose exec -T panel node server/dist/cli.js "$@"
  else
    compose run --rm --no-deps -T panel node server/dist/cli.js "$@"
  fi
}
json_field() { python3 -c 'import json,sys; print(json.load(sys.stdin).get(sys.argv[1], ""))' "$1"; }

# Сводка для входа, как у других панелей: адрес, логин, пароль - пароль показывается один раз.
print_access() { # print_access <логин> <пароль> [заголовок] [строка о 2FA; - = не писать]
  local url sub line tfa="${4:-настраивается при первом входе (приложение-аутентификатор)}"
  url="https://$(env_get PANEL_DOMAIN)"
  sub="$(env_get SUB_DOMAIN)"
  line="$(printf '%.0s=' $(seq 1 64))"
  # подписи - с пробелами вручную: printf считает ширину в байтах, а кириллица - по 2 байта
  printf '\n%s\n %s\n%s\n' "$line" "${3:-VPS Panel}" "$line"
  echo " Адрес:      $url"
  echo " Логин:      $1"
  [ -n "$2" ] && echo " Пароль:     $2"
  [ "$tfa" = - ] || echo " 2FA:        $tfa"
  [ -n "$sub" ] && echo " Подписки:   https://$sub"
  [ -n "$SELF_SERVER" ] && echo " Сервер:     $SELF_SERVER"
  printf '%s\n' "$line"
  [ -n "$2" ] && echo " Сохраните пароль сейчас: он показан один раз, восстановления нет."
  echo " Сброс пароля или 2FA - только здесь, в консоли: vps-panel admin password | 2fa"
  printf '%s\n' "$line"
}

# Агент из /etc/vps-agent/agent.json привязан к этой панели (её имя, прежнее имя или IP), а
# не к чужой: чужого агента не трогаем - переустановка отвязала бы сервер от той панели.
own_agent() { # own_agent <IP>
  local host
  host="$(python3 -c 'import json,sys,urllib.parse; print(urllib.parse.urlparse(json.load(open(sys.argv[1])).get("panelUrl","")).hostname or "")' "$AGENT_CFG" 2>/dev/null)" || return 1
  [ -n "$host" ] && { [ "$host" = "$(env_get PANEL_DOMAIN)" ] || [ "$host" = "$(env_get PANEL_ALIAS)" ] || [ "$host" = "$1" ]; }
}
agent_key() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("panelKey",""))' "$AGENT_CFG" 2>/dev/null || true; }

# Сервер самой панели в её списке серверов: строка (есть - она же, нет - "Сервер панели") и
# агент здесь же, без SSH, той же командой, что "Вручную" в окне установки агента. Итог - в
# SELF_SERVER для сводки; сбой не прерывает установку.
AGENT_CFG=/etc/vps-agent/agent.json
SELF_SERVER=""
attach_self_agent() { # attach_self_agent <внешний IP>
  local url js name cmd log n
  url="https://$(env_get PANEL_DOMAIN)"
  if [ -f "$AGENT_CFG" ] && ! own_agent "$1"; then
    SELF_SERVER="не добавлен: здесь стоит агент другой панели"
    return 0
  fi
  # агент проверяет сертификат панели: на свежей установке Caddy получает его до пары минут
  for n in $(seq 1 36); do
    curl --proto =https -fsS -m 8 "$url/api/health" >/dev/null 2>&1 && break
    [ "$n" = 36 ] && { SELF_SERVER="не добавлен: $url не открывается с этого сервера (сертификат или NAT) - \"Серверы\" -> \"Добавить сервер\""; return 0; }
    sleep 5
  done
  log="$(mktemp)"
  if ! js="$(panel_cli server-self "$1" 2>"$log")"; then
    SELF_SERVER="не добавлен: $(tail -n 1 "$log")"
    rm -f "$log"
    return 0
  fi
  name="$(echo "$js" | json_field name)"
  cmd="$(echo "$js" | json_field installCommand)"
  if ! sh -c "$cmd" >"$log" 2>&1; then
    tail -n 5 "$log" >&2
    rm -f "$log"
    SELF_SERVER="$name: агент не установлен - \"Установить агент\" в карточке сервера"
    return 0
  fi
  rm -f "$log"
  # агент подключился - одноразовый токен в конфиге сменился постоянным
  for n in $(seq 1 15); do
    grep -q '"token"' "$AGENT_CFG" 2>/dev/null && { SELF_SERVER="$name, агент в сети"; return 0; }
    sleep 2
  done
  SELF_SERVER="$name, агент ещё не подключился: journalctl -u vps-agent"
}

cmd_install() {
  need_root
  local VERSION="" CHANNEL=stable NO_AGENT=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -y) YES=1 ;;
      --beta) CHANNEL=beta ;;
      --no-agent) NO_AGENT=1 ;;
      --version) VERSION="${2:-}"; shift ;;
      *) die "install: неизвестный ключ $1" ;;
    esac
    shift
  done
  [ -f "$ENV_FILE" ] && die "панель уже установлена в $ROOT: обновление - vps-panel update"
  [ -f "$DATA/panel.db" ] && die "в $DATA уже есть база панели, а $ENV_FILE нет: верните прежний .env (или panel.env из резервной копии панели): новый SESSION_SECRET сделает зашифрованные в базе доступы нечитаемыми"
  command -v apt-get >/dev/null || warn "не Debian/Ubuntu: недостающие пакеты ставить руками"
  local miss=() p
  for p in curl python3 openssl ca-certificates iproute2; do dpkg -s "$p" >/dev/null 2>&1 || miss+=("$p"); done
  if [ "${#miss[@]}" -gt 0 ]; then
    say "ставлю пакеты: ${miss[*]}"
    DEBIAN_FRONTEND=noninteractive apt-get update -qq
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${miss[@]}" >/dev/null
  fi
  [ -n "$VERSION" ] || VERSION="$(latest_version "$CHANNEL")"
  echo "$VERSION" | grep -qE "$SEMVER" || die "версия $VERSION: нужна вида X.Y.Z или X.Y.Z-beta.N"
  say "установка VPS Panel $VERSION в $ROOT"

  local DOMAIN="${PANEL_DOMAIN:-}" SUB EMAIL LOGIN="${PANEL_LOGIN:-}" IP TLS=domain SNI=""
  DOCKER_BY_PANEL=0
  IP="$(public_ip)"
  while :; do
    ask "Домен панели (A-запись на этот сервер; Enter - без домена, по IP-адресу)" "$DOMAIN"
    DOMAIN="$(echo "$REPLY" | tr 'A-Z' 'a-z')"
    [ -z "$DOMAIN" ] && break
    echo "$DOMAIN" | grep -qE "$DOMAIN_RE" && break
    [ "$YES" = 1 ] && die "PANEL_DOMAIN неверный: '$DOMAIN' (пусто - панель по IP)"
    warn "нужен домен вида panel.example.com (IDN - в punycode, xn--...) или пусто - по IP"
  done
  if [ -z "$DOMAIN" ]; then
    # без домена: https://<IP> с сертификатом Let's Encrypt на IP-адрес (6 дней, Caddy продлевает)
    echo "$IP" | grep -qE '^[0-9]+(\.[0-9]+){3}$' || die "внешний IPv4 сервера определить не удалось - без домена панель не поставить"
    DOMAIN="$IP" TLS=ip SNI="$IP" SUB=""
    say "без домена: панель будет по адресу https://$IP"
    cat <<TXT
Сертификат: Let's Encrypt на IP-адрес (6 дней, Caddy продлевает его), браузер не предупреждает.
Без домена нет: входа в панели 3X-UI и MTProxyL через поддомены (они открываются напрямую, если
их порт открыт), отдельного имени для подписок, имени naive на этом сервере. Домен добавляется
позже: vps-panel domain <имя>; адрес по IP продолжит работать для агентов и подписок.
TXT
  else
    SUB="${SUB_DOMAIN-sub.$DOMAIN}"
    ask "Имя для подписок и личных страниц клиентов (своя A-запись; - = на домене панели)" "${SUB:--}"
    SUB="$(echo "$REPLY" | tr 'A-Z' 'a-z')"
    [ "$SUB" = "-" ] && SUB=""
  fi
  EMAIL="${ACME_EMAIL:-}"
  while :; do
    ask "Почта для Let's Encrypt (учётная запись сертификатов)" "$EMAIL"
    EMAIL="$REPLY"
    echo "$EMAIL" | grep -qE '^[^@ ]+@[^@ ]+\.[^@ ]+$' && break
    [ "$YES" = 1 ] && die "ACME_EMAIL не задан или неверный"
    warn "нужен адрес почты"
  done
  while :; do
    ask "Логин администратора панели (Enter - случайный)" "$LOGIN"
    LOGIN="$REPLY"
    [ -z "$LOGIN" ] && break
    echo "$LOGIN" | grep -qE "$LOGIN_RE" && break
    [ "$YES" = 1 ] && die "PANEL_LOGIN неверный: 3-32 символа, латиница, цифры, точка, дефис, подчёркивание"
    warn "логин: 3-32 символа, латиница, цифры, точка, дефис, подчёркивание"
  done

  if [ "$TLS" = domain ]; then
    say "проверка DNS"
    local got name dns_bad=0
    [ -n "$IP" ] && echo "внешний адрес сервера: $IP" || warn "внешний адрес сервера определить не удалось"
    for name in "$DOMAIN" ${SUB:+"$SUB"}; do
      got="$(resolve4 "$name")"
      if [ -z "$got" ]; then
        warn "$name: A-записи нет"
        dns_bad=1
      elif [ -n "$IP" ] && ! echo " $got" | grep -q " $IP "; then
        warn "$name указывает на $got, а не на $IP"
        dns_bad=1
      else
        echo "$name -> $got ок"
      fi
    done
    if [ -n "$(resolve4 "vpsp-check-$RANDOM.$DOMAIN")" ]; then
      echo "*.$DOMAIN есть: панели сервисов через поддомены будут работать"
    else
      warn "*.$DOMAIN в DNS нет: панели сервисов (3X-UI, MTProxyL) через поддомены не откроются, пока не заведена wildcard-запись на этот сервер"
    fi
    if [ "$dns_bad" = 1 ]; then
      warn "Caddy не получит сертификат, пока имена не указывают на этот сервер"
      confirm "Продолжить всё равно?" || exit 1
    fi
  fi

  say "проверка портов 80 и 443"
  local busy
  busy="$(ss -ltnupH 2>/dev/null | awk '$5 ~ /:(80|443)$/' || true)"
  if [ -n "$busy" ]; then
    echo "$busy"
    die "порты 80 или 443 заняты: их должен слушать Caddy панели"
  fi
  echo "свободны"

  if ! command -v docker >/dev/null; then
    say "docker не установлен"
    confirm "Поставить docker официальным скриптом get.docker.com?" || die "нужен docker с compose plugin"
    curl -fsSL https://get.docker.com | sh
    DOCKER_BY_PANEL=1
  fi
  docker compose version >/dev/null 2>&1 || die "нет docker compose plugin (пакет docker-compose-plugin)"

  say "файлы релиза $VERSION"
  mkdir -p "$ROOT" "$ROOT/sites" "$DATA/update"
  TMPD="$(mktemp -d)"
  local tmp="$TMPD"
  fetch_release "$VERSION" "$tmp"
  install -m 644 "$tmp/compose.yml" "$tmp/Caddyfile" "$tmp/fail2ban-panel.conf" "$tmp/fail2ban-panel.jail" "$ROOT/"
  install_cli "$tmp/vps-panel"
  umask 077
  cat >"$ENV_FILE" <<ENV
# VPS Panel: настройки установки. SESSION_SECRET - ключ шифрования данных в базе: храните
# копию этого файла (или бэкап панели) отдельно от сервера.
PANEL_DOMAIN=$DOMAIN
SUB_DOMAIN=$SUB
ACME_EMAIL=$EMAIL
# сертификаты: domain - на имена; ip - и на IP-адрес (панель без домена или прежний адрес по IP)
PANEL_TLS=$TLS
PANEL_SNI=$SNI
# прежний адрес панели после "vps-panel domain": по нему продолжают ходить агенты и подписки
PANEL_ALIAS=
SESSION_SECRET=$(openssl rand -base64 48 | tr -d '\n')
LOG_LEVEL=info
# внешний HTTP-прокси для api.telegram.org вместо встроенного xray; пусто - без него
TG_PROXY_URL=
# версия меняет "vps-panel update"; канал - для обновления без версии (stable или beta)
PANEL_VERSION=$VERSION
PANEL_CHANNEL=$CHANNEL
# docker поставлен установщиком панели: полная зачистка (uninstall --full) снимет и его
DOCKER_BY_PANEL=${DOCKER_BY_PANEL:-0}
ENV
  umask 022
  chmod 600 "$ENV_FILE"
  chown -R 1000:1000 "$DATA"
  chmod 700 "$DATA"

  say "образы и запуск (первый раз - минута-две)"
  compose pull || die "образы не скачались с ghcr.io: проверьте доступ к ghcr.io и pkg-containers.githubusercontent.com"
  say "администратор панели"
  local admin_json ADMIN_LOGIN ADMIN_PASSWORD
  admin_json="$(panel_cli admin-init ${LOGIN:+"$LOGIN"})" || die "администратор не создан: vps-panel admin init"
  ADMIN_LOGIN="$(echo "$admin_json" | json_field login)"
  ADMIN_PASSWORD="$(echo "$admin_json" | json_field password)"
  ACCESS_LOGIN="$ADMIN_LOGIN" ACCESS_PASSWORD="$ADMIN_PASSWORD"
  echo "создан: $ADMIN_LOGIN (пароль - в сводке в конце)"
  compose up -d
  say "жду ответа https://$DOMAIN/api/health"
  if wait_health "$VERSION" 300; then echo "панель отвечает"; else warn "за 5 минут панель не ответила: vps-panel logs"; fi

  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; then
    say "ufw: разрешаю 80/tcp, 443/tcp, 443/udp"
    ufw allow 80/tcp >/dev/null
    ufw allow 443/tcp >/dev/null
    ufw allow 443/udp >/dev/null
  fi
  say "fail2ban для входа в панель"
  install_fail2ban
  install_units

  if [ "$NO_AGENT" = 1 ]; then
    SELF_SERVER="не добавлен (--no-agent)"
  else
    say "сервер панели в списке серверов"
    attach_self_agent "$IP"
    echo "$SELF_SERVER"
  fi

  say "готово"
  ACCESS_LOGIN=""
  print_access "$ADMIN_LOGIN" "$ADMIN_PASSWORD" "VPS Panel $VERSION установлена"
  cat <<MSG
Дальше: вход в панель и настройка 2FA. Сервисы на сервер панели ставит "Настроить сервер" в
его карточке, другие серверы - "Серверы" -> "Добавить сервер". Резервную копию панели
(Настройки) стоит включить сразу. Обновления приходят в панель (Настройки -> Версия панели), из
консоли: vps-panel update. Все команды: vps-panel help
MSG
}

# ---------------------------------------------------------------- update
CURRENT=""
TARGET=""
cmd_update() {
  need_root
  local force=0 channel
  channel="$(env_get PANEL_CHANNEL)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --beta) channel=beta ;;
      -y) YES=1 ;;
      *) TARGET="$1" ;;
    esac
    shift
  done
  [ -f "$ENV_FILE" ] || die "панель не установлена в $ROOT (vps-panel install)"
  exec 9>/run/vps-panel-update.lock
  flock -n 9 || die "обновление уже идёт"
  CURRENT="$(env_get PANEL_VERSION)"
  [ -n "$TARGET" ] || TARGET="$(latest_version "${channel:-stable}")"
  echo "$TARGET" | grep -qE "$SEMVER" || die "версия $TARGET: нужна вида X.Y.Z или X.Y.Z-beta.N"
  if [ "$TARGET" = "$CURRENT" ] && [ "$force" = 0 ]; then
    # в .env версия ставится до перезапуска: панель ей не отвечает - прошлое обновление
    # оборвалось, ставится заново
    if wait_health "$CURRENT" 5; then
      echo "уже $CURRENT"
      return 0
    fi
    warn "панель не отвечает версией $CURRENT - установка заново"
  fi
  STARTED="$(date +%s)"
  TAIL_FILE="$(mktemp)"
  TMPD="$(mktemp -d)"
  UPDATING=1
  local tmp="$TMPD"
  say "обновление $CURRENT -> $TARGET"
  status building 1 4 "файлы релиза"
  ( fetch_release "$TARGET" "$tmp" ) >>"$TAIL_FILE" 2>&1 || { status failed 1 4 "файлы релиза"; cat "$TAIL_FILE" >&2; exit 1; }

  # прежние файлы - для отката
  rm -rf "$PREV"
  mkdir -p "$PREV"
  cp -p "$ROOT/compose.yml" "$ROOT/Caddyfile" "$ENV_FILE" "$PREV/"
  restore() {
    restore_files
    compose up -d >>"$TAIL_FILE" 2>&1 || true
  }
  SWAPPED=1
  install -m 644 "$tmp/compose.yml" "$tmp/Caddyfile" "$tmp/fail2ban-panel.conf" "$tmp/fail2ban-panel.jail" "$ROOT/"
  env_set PANEL_VERSION "$TARGET"
  env_set PANEL_PREV_VERSION "$CURRENT"
  # папка своих сайтов (монтируется в Caddy): иначе её создал бы docker от root при запуске
  mkdir -p "$SITES"

  status building 2 4 "загрузка образов"
  if ! compose pull >>"$TAIL_FILE" 2>&1; then
    restore
    status failed 2 4 "загрузка образов"
    die "образы $TARGET не скачались - осталась $CURRENT"
  fi
  if ! compose run --rm --no-deps -T --entrypoint caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >>"$TAIL_FILE" 2>&1; then
    caddy_errors "$TAIL_FILE" >&2
    restore
    status failed 2 4 "проверка Caddyfile"
    local hint=""
    [ -n "$(sites_files)" ] && hint=" (проверьте свои сайты: vps-panel sites)"
    die "Caddyfile релиза $TARGET не прошёл проверку$hint - осталась $CURRENT"
  fi

  status building 3 4 "перезапуск"
  # статус пишется до перезапуска: прежняя панель успевает показать полосу
  compose up -d --remove-orphans >>"$TAIL_FILE" 2>&1 || true
  status building 4 4 "проверка новой версии"
  if ! wait_health "$TARGET" 180; then
    restore
    status failed 4 4 "проверка новой версии" "$CURRENT"
    die "$TARGET не ответила за 3 минуты, возвращена $CURRENT (vps-panel logs)"
  fi
  install_cli "$tmp/vps-panel"
  # jail fail2ban - по правилам нового релиза (его же командой), там, где jail уже стоял
  if [ -f /etc/fail2ban/jail.d/vps-panel.conf ]; then
    "$CLI_PATH" fail2ban >>"$TAIL_FILE" 2>&1 || warn "jail fail2ban не обновился: vps-panel fail2ban"
  fi
  status done 4 4 "готово" "$TARGET"
  # старые образы - в мусор (остаётся текущий и прошлый для отката)
  docker image prune -f >/dev/null 2>&1 || true
  echo "обновлено: $TARGET"
}

cmd_rollback() {
  local p
  p="$(env_get PANEL_PREV_VERSION)"
  [ -n "$p" ] || die "прошлой версии нет"
  cmd_update "$p" --force
}

# Запрос из панели: data/update/request.json {"version": "X.Y.Z"} - пишет панель (uid 1000),
# здесь только версия вида semver; всё остальное в файле не читается.
cmd_serve_request() {
  need_root
  local v
  [ -f "$REQUEST" ] || return 0
  v="$(python3 -c 'import json,sys; print(str(json.load(open(sys.argv[1])).get("version","")))' "$REQUEST" 2>/dev/null || true)"
  rm -f "$REQUEST"
  echo "$v" | grep -qE "$SEMVER" || { warn "запрос обновления без верной версии: '$v'"; exit 1; }
  cmd_update "$v"
}

cmd_status() {
  [ -f "$ENV_FILE" ] || die "панель не установлена в $ROOT"
  echo "версия: $(env_get PANEL_VERSION), канал: $(channel_name "$(env_get PANEL_CHANNEL)")"
  compose ps
}

cmd_channel() {
  need_root
  case "${1:-}" in
    stable | beta) env_set PANEL_CHANNEL "$1"; echo "канал: $(channel_name "$1")" ;;
    "") echo "канал: $(channel_name "$(env_get PANEL_CHANNEL)")" ;;
    *) die "канал: stable (стабильный) или beta (предварительный)" ;;
  esac
}

# Снять панель. Без ключей - только панель (контейнеры, образы, служба обновлений, jail
# fail2ban панели, команда vps-panel), данные остаются; --purge - и данные с сертификатами.
# --full - всё, что ставила панель на этом сервере: панель с данными, агент, прокси для
# браузера, port-sync, VPN-сервисы (3X-UI, MTProxyL, WDTT, OpenFlux, контейнеры Amnezia - их
# список подтверждается отдельно) и docker, если его ставил установщик и других контейнеров
# не осталось. Защита сервера (вход SSH по ключу, jail sshd, автообновления, ufw и его
# правила) остаётся: снять её - значит открыть сервер.
cmd_uninstall() {
  need_root
  local mode=panel
  while [ $# -gt 0 ]; do
    case "$1" in
      --purge) mode=purge ;;
      --full) mode=full ;;
      -y) YES=1 ;;
      *) die "uninstall: неизвестный ключ $1 (--purge, --full, -y)" ;;
    esac
    shift
  done
  if [ "$mode" = full ]; then
    full_uninstall
    return
  fi
  confirm "Остановить и снять VPS Panel?" || exit 1
  [ "$mode" = purge ] && { confirm "Удалить и данные ($DATA, сертификаты Caddy, свои сайты в $SITES)? Без резервной копии их не вернуть" || exit 1; }
  remove_panel "$mode"
  if [ "$mode" = purge ]; then
    echo "снято вместе с данными"
  else
    echo "снято; данные остались в $ROOT (vps-panel uninstall --purge - удалить и их)"
  fi
  echo "Агент, прокси для браузера и VPN-сервисы этого сервера не тронуты (всё сразу - uninstall --full)."
}

# remove_panel <panel|purge|full>: контейнеры и образы панели, службы, jail, каталог
remove_panel() {
  systemctl disable --now vps-panel-update.path >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/vps-panel-update.path /etc/systemd/system/vps-panel-update.service
  systemctl daemon-reload
  if [ -f "$ROOT/compose.yml" ] && [ -f "$ENV_FILE" ]; then
    if [ "$1" = panel ]; then
      compose down --rmi all || true
    else
      compose down -v --rmi all || true
    fi
  fi
  rm -f /etc/fail2ban/jail.d/vps-panel.conf /etc/fail2ban/filter.d/vps-panel.conf
  systemctl restart fail2ban >/dev/null 2>&1 || true
  if [ "$1" != panel ]; then
    rm -rf "$ROOT"
    rm -f "$CLI_PATH"
  fi
}

full_uninstall() {
  local domain vpn=() items=() c
  domain="$(env_get PANEL_DOMAIN)"
  [ -x /usr/local/x-ui/x-ui ] && vpn+=("3X-UI (панель, Xray, база пользователей)")
  command -v mtproxyl >/dev/null 2>&1 && vpn+=("MTProxyL (прокси Telegram, веб-панель, секреты)")
  [ -x /usr/local/bin/wdtt-server ] && vpn+=("WDTT")
  { [ -d /etc/openflux-node ] || [ -x /opt/openflux-node/node-install.sh ]; } && vpn+=("OpenFlux (все каналы)")
  local awg=()
  if command -v docker >/dev/null 2>&1; then
    while read -r c; do [ -n "$c" ] && awg+=("$c"); done < <(docker ps -a --format '{{.Names}}' | grep -E '^amnezia-' || true)
  fi
  [ "${#awg[@]}" -gt 0 ] && vpn+=("Amnezia: ${awg[*]}")
  [ -f "$ENV_FILE" ] && items+=("панель ${domain:-} с данными, сертификатами и образами")
  [ -n "$(sites_files)" ] && items+=("файлы своих сайтов в $SITES (контейнеры сайтов остаются)")
  [ -f /etc/systemd/system/vps-agent.service ] && items+=("агент панели (vps-agent)")
  [ -f /etc/systemd/system/vps-naive.service ] && items+=("прокси для браузера (vps-naive)")
  [ -x /usr/local/sbin/vps-portsync ] && items+=("port-sync (порты снятых сервисов в ufw закрываются, SSH остаётся)")
  [ "$(env_get DOCKER_BY_PANEL)" = 1 ] && items+=("docker (ставил установщик панели; снимется, если других контейнеров нет)")

  say "Полная зачистка сервера от VPS Panel"
  printf '  - %s\n' "${items[@]}"
  if [ "${#vpn[@]}" -gt 0 ]; then
    echo "VPN-сервисы на этом сервере (клиенты перестанут подключаться, пользователи и ключи пропадут):"
    printf '  - %s\n' "${vpn[@]}"
  fi
  echo "Остаётся: вход SSH по ключу, jail sshd, автообновления безопасности, ufw."
  if [ "$YES" != 1 ]; then
    local typed
    read -r -p "Это необратимо. Введите домен панели (${domain:-vps-panel}) для подтверждения: " typed </dev/tty || die "нет терминала: запустите с -y"
    [ "$typed" = "${domain:-vps-panel}" ] || die "не совпало - ничего не удалено"
  fi
  local drop_vpn=0
  if [ "${#vpn[@]}" -gt 0 ]; then
    if confirm "Удалить и VPN-сервисы из списка выше?"; then drop_vpn=1; else echo "VPN-сервисы остаются"; fi
  fi

  if [ "$drop_vpn" = 1 ]; then
    if [ -x /usr/local/x-ui/x-ui ]; then
      say "3X-UI"
      printf 'y\n' | x-ui uninstall >/dev/null 2>&1 || true
      rm -f /etc/fail2ban/jail.d/xui-panel.conf /etc/fail2ban/filter.d/xui-panel.conf
      [ -e /usr/local/x-ui/x-ui ] && warn "3X-UI удалился не полностью: /usr/local/x-ui остался"
    fi
    if command -v mtproxyl >/dev/null 2>&1; then
      say "MTProxyL"
      if systemctl cat mtproxyl-panel >/dev/null 2>&1; then
        printf 'y\n' | mtproxyl panel uninstall --no-confirm >/dev/null 2>&1 || true
      fi
      printf 'yes\nn\n' | mtproxyl uninstall >/dev/null 2>&1 || warn "mtproxyl uninstall завершился с ошибкой"
    fi
    if [ -x /usr/local/bin/wdtt-server ]; then
      say "WDTT"
      # установщик WDTT лежит в образе панели - пока панель ещё здесь
      local pc
      pc="$(docker ps --filter label=com.docker.compose.service=panel --format '{{.Names}}' 2>/dev/null | head -1)"
      if [ -n "$pc" ] && docker cp "$pc:/app/files/wdtt/deploy.sh" /tmp/wdtt-deploy.sh 2>/dev/null; then
        bash /tmp/wdtt-deploy.sh uninstall </dev/null >/dev/null 2>&1 || warn "WDTT: deploy.sh uninstall завершился с ошибкой"
        rm -f /tmp/wdtt-deploy.sh
      else
        systemctl disable --now wdtt >/dev/null 2>&1 || true
        rm -f /etc/systemd/system/wdtt.service /usr/local/bin/wdtt-server
      fi
    fi
    if [ -x /opt/openflux-node/node-install.sh ]; then
      say "OpenFlux"
      sh /opt/openflux-node/node-install.sh uninstall </dev/null >/dev/null 2>&1 || warn "OpenFlux: uninstall завершился с ошибкой"
    fi
    for c in "${awg[@]}"; do
      say "Amnezia: $c"
      docker rm -f "$c" >/dev/null 2>&1 || true
      docker image rm "$c" >/dev/null 2>&1 || true
      rm -rf "/opt/amnezia/$c"
    done
    rmdir /opt/amnezia 2>/dev/null || true
  fi

  if [ -f /etc/systemd/system/vps-naive.service ]; then
    say "прокси для браузера"
    systemctl disable --now vps-naive vps-naive-cert.timer >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/vps-naive.service /etc/systemd/system/vps-naive-cert.service \
      /etc/systemd/system/vps-naive-cert.timer /usr/local/sbin/vps-naive-cert
    rm -rf /opt/vps-naive /etc/vps-naive /var/lib/vps-naive
    userdel vps-naive 2>/dev/null || true
  fi
  if [ -x /usr/local/sbin/vps-portsync ]; then
    say "port-sync"
    # последний проход: сервисы уже сняты - он закроет их порты в ufw (SSH остаётся)
    timeout 120 /usr/local/sbin/vps-portsync >/dev/null 2>&1 || true
    systemctl disable --now vps-portsync.timer vps-portsync-xui.path vps-portsync-docker-watch.service vps-portsync.service >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/vps-portsync.service /etc/systemd/system/vps-portsync.timer \
      /etc/systemd/system/vps-portsync-xui.path /etc/systemd/system/vps-portsync-docker-watch.service \
      /usr/local/sbin/vps-portsync /etc/vps-portsync.conf
    rm -rf /var/lib/vps-portsync
  fi
  if [ -f /etc/systemd/system/vps-agent.service ]; then
    say "агент панели"
    systemctl disable --now vps-agent >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/vps-agent.service /usr/local/bin/vps-agent
    rm -rf /etc/vps-agent
  fi
  local docker_by_panel
  docker_by_panel="$(env_get DOCKER_BY_PANEL)"
  if [ -f "$ENV_FILE" ] || [ -d "$ROOT" ]; then
    say "панель"
    remove_panel full
  fi
  systemctl daemon-reload
  if [ "$docker_by_panel" = 1 ] && command -v docker >/dev/null 2>&1; then
    if [ -z "$(docker ps -aq)" ]; then
      say "docker (ставил установщик панели)"
      systemctl disable --now docker docker.socket containerd >/dev/null 2>&1 || true
      DEBIAN_FRONTEND=noninteractive apt-get purge -y -qq docker-ce docker-ce-cli containerd.io \
        docker-buildx-plugin docker-compose-plugin docker-ce-rootless-extras >/dev/null 2>&1 || true
      rm -rf /var/lib/docker /var/lib/containerd /etc/apt/sources.list.d/docker.list /etc/apt/keyrings/docker.asc
    else
      echo "docker остаётся: на сервере есть другие контейнеры ($(docker ps -a --format '{{.Names}}' | tr '\n' ' '))"
    fi
  fi
  say "готово: VPS Panel снята с сервера"
  [ "$drop_vpn" = 1 ] || [ "${#vpn[@]}" -eq 0 ] || echo "VPN-сервисы оставлены и работают."
}

# ---------------------------------------------------------------- sites
# Свои сайты: файлы sites/*.caddy, их подключает Caddyfile панели. Проверка - caddy validate
# всего конфига (с панелью и подписками); reload применяет только проверенный конфиг и без
# перезапуска: если reload не прошёл, Caddy остаётся на прежнем.
sites_files() { find "$SITES" -maxdepth 1 -type f -name '*.caddy' 2>/dev/null | sort; }
# адреса блоков сайтов в файле: строки вида "имя {" без отступа (сниппеты "(имя) {" - не сайты)
site_names() { grep -E '^[^#([:space:]][^{]*\{' "$1" | sed -E 's/[[:space:]]*\{.*//' | tr '\n' ' ' || true; }
# ошибки из вывода caddy (журнал JSON и "Error: ..."), последние три; нет таких - хвост вывода
caddy_errors() { # caddy_errors <файл с выводом>
  local e
  e="$( { grep -E '"level":"error"' "$1" | sed -E 's/.*"msg":"(([^"\\]|\\.)*)".*/\1/' || true; grep -E '^Error' "$1" || true; } | tail -n 3)"
  if [ -n "$e" ]; then echo "$e"; else tail -n 5 "$1"; fi
}
caddy_running() { [ -n "$(compose ps -q --status running caddy 2>/dev/null)" ]; }
caddy_cli() { # caddy_cli <аргументы caddy>: запущен - exec, нет - разовый контейнер
  if caddy_running; then
    compose exec -T caddy caddy "$@"
  else
    compose run --rm --no-deps -T --entrypoint caddy caddy "$@"
  fi
}
cmd_sites() {
  need_root
  [ -f "$ENV_FILE" ] || die "панель не установлена в $ROOT"
  case "${1:-}" in "" | reload) ;; *) die "vps-panel sites [reload]" ;; esac
  mkdir -p "$SITES"
  local files f names log wild=""
  files="$(sites_files)"
  if [ -z "$files" ]; then
    echo "сайтов нет: файлы <имя>.caddy - в $SITES"
  else
    echo "сайты ($SITES):"
    while read -r f; do
      names="$(site_names "$f")"
      echo "  $(basename "$f"): ${names:-адресов не найдено}"
      # wildcard Caddy пропускает, но такой блок перехватил бы поддомены панелей сервисов, а
      # сертификат на него без DNS-проверки не выпустить
      case "$names" in *"*"*) wild="$wild $(basename "$f")" ;; esac
    done <<<"$files"
  fi
  [ -z "$wild" ] || die "адрес с wildcard в:$wild - нужно одно конкретное имя на блок (app.example.com)"
  TMPD="$(mktemp -d)"
  log="$TMPD/caddy.log"
  if ! caddy_cli validate --config /etc/caddy/Caddyfile --adapter caddyfile >"$log" 2>&1; then
    caddy_errors "$log" >&2
    [ "${1:-}" = reload ] && die "конфиг Caddy неверный - не применён, Caddy работает на прежнем"
    die "конфиг Caddy неверный: при перезапуске Caddy не запустится, а с ним панель и подписки - исправьте файлы в $SITES"
  fi
  echo "конфиг Caddy верный"
  [ "${1:-}" = reload ] || return 0
  if caddy_running; then
    compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >"$log" 2>&1 ||
      { caddy_errors "$log" >&2; die "caddy reload не прошёл - Caddy работает на прежнем конфиге"; }
    echo "применено без перезапуска; сертификаты новых имён Caddy выпускает сам (журнал: vps-panel logs caddy)"
  else
    say "Caddy не запущен - запуск"
    compose up -d caddy
  fi
}

# Администратор панели из консоли: восстановления пароля в панели нет - сброс только здесь.
cmd_admin() {
  need_root
  [ -f "$ENV_FILE" ] || die "панель не установлена в $ROOT"
  local r login pw args=() a
  for a in "$@"; do [ "$a" = -y ] && YES=1 || args+=("$a"); done
  set -- "${args[@]}"
  case "${1:-show}" in
    show)
      r="$(panel_cli admin-show)" || exit 1
      echo "логин: $(echo "$r" | json_field login)"
      echo "2FA: $([ "$(echo "$r" | json_field totpEnabled)" = True ] && echo включена || echo "не настроена - при входе")"
      echo "открытых сессий: $(echo "$r" | json_field sessions)"
      echo "адрес: https://$(env_get PANEL_DOMAIN)"
      ;;
    password)
      confirm "Задать администратору новый случайный пароль? Все сессии панели закроются" || exit 1
      r="$(panel_cli admin-password)" || exit 1
      print_access "$(echo "$r" | json_field login)" "$(echo "$r" | json_field password)" "Новый пароль администратора" "без изменений; все сессии закрыты"
      ;;
    2fa)
      confirm "Сбросить 2FA? Её настроят заново при следующем входе; все сессии закроются" || exit 1
      r="$(panel_cli admin-2fa)" || exit 1
      echo "2FA сброшена: при следующем входе (логин $(echo "$r" | json_field login)) панель покажет новый QR-код"
      ;;
    login)
      login="${2:-}"
      echo "$login" | grep -qE "$LOGIN_RE" || die "vps-panel admin login <имя>: 3-32 символа, латиница, цифры, точка, дефис, подчёркивание"
      r="$(panel_cli admin-login "$login")" || exit 1
      echo "логин администратора: $(echo "$r" | json_field login)"
      ;;
    init)
      login="${2:-}"
      [ -z "$login" ] || echo "$login" | grep -qE "$LOGIN_RE" || die "логин: 3-32 символа, латиница, цифры, точка, дефис, подчёркивание"
      r="$(panel_cli admin-init ${login:+"$login"})" || exit 1
      pw="$(echo "$r" | json_field password)"
      print_access "$(echo "$r" | json_field login)" "$pw" "Администратор создан"
      ;;
    *) die "vps-panel admin [show | password | 2fa | login <имя> | init [имя]]" ;;
  esac
}

# Управление через Telegram-бота: выключить без входа в панель (аккаунт Telegram потерян).
cmd_bot() {
  need_root
  [ -f "$ENV_FILE" ] || die "панель не установлена в $ROOT"
  case "${1:-}" in
    off)
      local r
      r="$(panel_cli bot-off)" || exit 1
      if [ "$(echo "$r" | json_field unbound)" = True ]; then
        echo "управление через бота отключено, аккаунт Telegram отвязан"
      else
        echo "управление через бота отключено"
      fi
      echo "привязать заново: \"Настройки\" - \"Уведомления в Telegram\""
      ;;
    *) die "vps-panel bot off" ;;
  esac
}

# Домен панели: была по IP (или другой домен). Прежний адрес остаётся (PANEL_ALIAS): по нему
# ходят агенты и подписки клиентов, выданные раньше; агенты сами переходят на новый адрес при
# следующем подключении.
cmd_domain() {
  need_root
  [ -f "$ENV_FILE" ] || die "панель не установлена в $ROOT"
  local DOMAIN="" SUB="" set_sub=0 OLD IP got
  while [ $# -gt 0 ]; do
    case "$1" in
      --sub) SUB="$(echo "${2:-}" | tr 'A-Z' 'a-z')"; set_sub=1; shift ;;
      -y) YES=1 ;;
      -*) die "domain: неизвестный ключ $1" ;;
      *) DOMAIN="$(echo "$1" | tr 'A-Z' 'a-z')" ;;
    esac
    shift
  done
  OLD="$(env_get PANEL_DOMAIN)"
  if [ -z "$DOMAIN" ]; then
    got="$(env_get PANEL_ALIAS)"
    echo "адрес панели: https://$OLD${got:+ (и прежний https://$got)}"
    echo "сменить: vps-panel domain <имя> [--sub <имя для подписок>]"
    return
  fi
  echo "$DOMAIN" | grep -qE "$DOMAIN_RE" || die "нужен домен вида panel.example.com"
  [ "$DOMAIN" = "$OLD" ] && die "панель уже на $DOMAIN"
  [ "$set_sub" = 0 ] || [ -z "$SUB" ] || echo "$SUB" | grep -qE "$DOMAIN_RE" || die "--sub: нужен домен вида sub.example.com"
  # подписки и личные страницы клиентов: старый адрес перестанет их отдавать - выданные ссылки
  # сломаются (имя подписок сменилось или прежний адрес панели уходит из PANEL_ALIAS)
  local old_sub lost="" n
  old_sub="$(env_get SUB_DOMAIN)"
  if [ "$set_sub" = 1 ] && [ "$SUB" != "$old_sub" ]; then
    lost="${old_sub:-$OLD}"
  elif [ -z "$old_sub" ] && [ -n "$(env_get PANEL_ALIAS)" ] && [ "$(env_get PANEL_ALIAS)" != "$DOMAIN" ]; then
    lost="$(env_get PANEL_ALIAS)"
  fi
  if [ -n "$lost" ]; then
    n="$(panel_cli clients-count 2>/dev/null | json_field clients || true)"
    if [ "${n:-0}" != 0 ]; then
      warn "ссылки клиентов на https://$lost (подписки и личные страницы, клиентов: $n) перестанут работать: клиентам нужно выдать новые"
      confirm "Продолжить?" || exit 1
    fi
  fi
  IP="$(public_ip)"
  for name in "$DOMAIN" ${SUB:+"$SUB"}; do
    got="$(resolve4 "$name")"
    if [ -z "$got" ] || { [ -n "$IP" ] && ! echo " $got" | grep -q " $IP "; }; then
      warn "$name: A-запись ${got:-не найдена}${IP:+, а сервер - $IP}"
      confirm "Caddy не получит сертификат, пока имя не указывает на этот сервер. Продолжить?" || exit 1
    else
      echo "$name -> $got ок"
    fi
  done
  env_set PANEL_DOMAIN "$DOMAIN"
  env_set PANEL_ALIAS "$OLD"
  [ "$set_sub" = 1 ] && env_set SUB_DOMAIN "$SUB"
  # прежний адрес - IP: его сертификат (на IP) продолжает выпускаться
  if echo "$OLD" | grep -qE '^[0-9]+(\.[0-9]+){3}$'; then
    env_set PANEL_TLS ip
    env_set PANEL_SNI "$OLD"
  fi
  say "перезапуск панели с новым адресом"
  compose up -d
  if wait_health "$(env_get PANEL_VERSION)" 180; then echo "панель отвечает"; else warn "панель не ответила за 3 минуты: vps-panel logs"; fi
  cat <<MSG
Панель: https://$DOMAIN (прежний адрес https://$OLD тоже работает).
Агенты новой версии перейдут на новый адрес сами при следующем подключении. Панели 3X-UI и
MTProxyL через панель откроются, когда в DNS будет *.$DOMAIN на этот сервер.
MSG
}

# Восстановление из бэкапа панели (Настройки -> Бэкап панели) на установленной панели: база,
# ключ панели для агентов, ключ SSH панели (если есть), выход xray и SESSION_SECRET. Прежние
# данные этой установки - в data/before-restore-<время>.
cmd_restore() {
  need_root
  [ -f "$ENV_FILE" ] || die "панель не установлена в $ROOT: сначала установка (install), потом restore"
  local file="" a
  for a in "$@"; do case "$a" in -y) YES=1 ;; -*) die "restore: неизвестный ключ $a" ;; *) file="$a" ;; esac; done
  [ -n "$file" ] && [ -f "$file" ] || die "vps-panel restore <файл резервной копии .tar.gz.enc>"
  local pw="${BACKUP_PASSWORD:-}"
  if [ -z "$pw" ]; then
    read -r -s -p "Пароль резервной копии: " pw </dev/tty 2>/dev/null || die "нет терминала: пароль - в BACKUP_PASSWORD"
    echo
  fi
  TMPD="$(mktemp -d)"
  local b="$TMPD/vps-panel-backup"
  if ! printf '%s' "$pw" | openssl enc -d -aes-256-cbc -pbkdf2 -iter 100000 -pass stdin -in "$file" 2>/dev/null | tar xz -C "$TMPD" 2>/dev/null; then
    die "не удалось расшифровать: неверный пароль или это не резервная копия панели"
  fi
  [ -f "$b/panel.db" ] && [ -f "$b/panel.env" ] && [ -f "$b/panel_agent_ed25519.pem" ] || die "в архиве нет panel.db, panel.env или ключа панели"
  local secret
  secret="$(sed -n 's/^SESSION_SECRET=//p' "$b/panel.env" | tail -1)"
  [ -n "$secret" ] || die "в panel.env архива нет SESSION_SECRET"
  echo "в архиве: $(sed -n 's/^PANEL_PUBLIC_URL=//p' "$b/panel.env") ($(du -h "$b/panel.db" | cut -f1) база)"
  confirm "Заменить данные этой панели данными из резервной копии?" || exit 1
  local keep="$DATA/before-restore-$(date +%Y%m%d-%H%M%S)"
  say "останавливаю панель, прежние данные - в $keep"
  compose stop panel >/dev/null
  mkdir -p "$keep"
  for a in panel.db panel_agent_ed25519.pem panel_ssh_ed25519 panel_ssh_ed25519.pub xray; do
    [ -e "$DATA/$a" ] && mv "$DATA/$a" "$keep/"
  done
  rm -f "$DATA/panel.db-wal" "$DATA/panel.db-shm"
  cp "$ENV_FILE" "$keep/env"
  install -m 600 "$b/panel.db" "$b/panel_agent_ed25519.pem" "$DATA/"
  [ -f "$b/panel_ssh_ed25519" ] && install -m 600 "$b/panel_ssh_ed25519" "$DATA/"
  [ -f "$b/panel_ssh_ed25519.pub" ] && install -m 644 "$b/panel_ssh_ed25519.pub" "$DATA/"
  [ -d "$b/xray" ] && cp -r "$b/xray" "$DATA/"
  chown -R 1000:1000 "$DATA"
  env_set SESSION_SECRET "$secret"
  say "запуск"
  compose up -d >/dev/null
  if wait_health "$(env_get PANEL_VERSION)" 180; then
    echo "панель восстановлена: https://$(env_get PANEL_DOMAIN) - вход прежним логином, паролем и 2FA"
    echo "агенты на серверах подключатся сами: ключ панели взят из резервной копии"
    # агент этого сервера ставила установка панели: он верит её ключу, а не ключу из копии
    local key
    key="$(panel_cli panel-key 2>/dev/null | json_field key || true)"
    if [ -f "$AGENT_CFG" ] && [ -n "$key" ] && [ "$(agent_key)" != "$key" ] && own_agent "$(public_ip)"; then
      say "агент этого сервера: привязка к восстановленной панели"
      attach_self_agent "$(public_ip)"
      echo "сервер панели: $SELF_SERVER"
    fi
  else
    warn "панель не ответила за 3 минуты: vps-panel logs; прежние данные - в $keep"
  fi
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  admin) shift; cmd_admin "$@" ;;
  bot) shift; cmd_bot "$@" ;;
  domain) shift; cmd_domain "$@" ;;
  update) shift; cmd_update "$@" ;;
  rollback) cmd_rollback ;;
  serve-request) cmd_serve_request ;;
  status) cmd_status ;;
  version) env_get PANEL_VERSION ;;
  channel) shift; cmd_channel "$@" ;;
  logs) shift; compose logs --tail 200 -f "$@" ;;
  restart) need_root; compose restart ;;
  fail2ban) need_root; install_fail2ban ;;
  sites) shift; cmd_sites "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  help | -h | --help) print_help ;;
  *) print_help; exit 1 ;;
esac
