# jail для панели: /etc/fail2ban/jail.d/vps-panel.conf
# Лог Caddy лежит в docker-томе deploy_caddy_data.
[vps-panel]
enabled = true
filter = vps-panel
logpath = /var/lib/docker/volumes/deploy_caddy_data/_data/access.log
maxretry = 5
findtime = 15m
bantime = 1h
backend = polling
# Caddy в docker: опубликованные порты идут через FORWARD (цепочка DOCKER-USER), бан в INPUT
# их не закрывает.
banaction = iptables-allports
chain = DOCKER-USER
