# Домен панели (A-запись должна указывать на этот сервер)
PANEL_DOMAIN=panel.example.com
# Почта для Let's Encrypt (уведомления об истечении)
ACME_EMAIL=you@example.com
# Секрет сессий: openssl rand -base64 48
SESSION_SECRET=
LOG_LEVEL=info
# Имя для подписок и личных страниц клиентов (своя A-запись на этот сервер, например
# sub.example.com); пусто - они на адресе панели
SUB_DOMAIN=
# Внешний HTTP-прокси для api.telegram.org вместо встроенного xray (Настройки -> Выход в
# Telegram); пусто - без него
TG_PROXY_URL=
